{
  "expo": {
    "name": "ZeroRisco",
    "slug": "zerorisco",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "zerorisco",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zerorisco.gps",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ZeroRisco precisa da sua localização para navegação GPS."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.zerorisco.gps",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o ZeroRisco acesse sua localização para navegação GPS.",
          "locationAlwaysPermission": "Permita que o ZeroRisco acesse sua localização em segundo plano para continuar navegando."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "13dddec6-69c5-48b4-b883-199fb4fbde92"
      }
    }
  }
}
